rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }


    // ORKEIT app collections
    match /orkeit_sites/{siteId} {
      allow read, write: if true;
    }

    match /orkeit_visits/{visitId} {
      allow read, write: if true;
    }

    match /orkeit_contracts/{contractId} {
      allow read, write: if true;
    }

    match /orkeit_extinguisher_maintenance/{maintenanceId} {
      allow read, write: if true;
    }

    match /orkeit_customers/{customerId} {
      allow read, write: if true;
    }

    match /orkeit_service_requests/{requestId} {
      allow read, write: if true;
    }

    // Users collection (Admins, Agents, and Clients)
    match /users/{userId} {
      allow read, write: if true; // Allow login verification and user provisioning
    }

    // Sites collection
    match /sites/{siteId} {
      allow read, write: if true; // Multi-device sync for field operations and clients
    }

    // Visits collection
    match /visits/{visitId} {
      allow read, write: if true;
    }

    // Followups collection
    match /followups/{followupId} {
      allow read, write: if true;
    }

    // Settings collection
    match /settings/{settingsId} {
      allow read, write: if true;
    }

    // Client incidents / tickets
    match /incidents/{incidentId} {
      allow read, write: if true;
    }

    // Client inquiries
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Contract renewal requests
    match /renewals/{renewalId} {
      allow read, write: if true;
    }

    // Civil Defense inspection alerts & records
    match /civil_defense_alerts/{alertId} {
      allow read, write: if true;
    }
  }
}
